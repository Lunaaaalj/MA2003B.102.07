# Configuracion de latexmk para esta carpeta (analoga a reports/.latexmkrc,
# sin biber porque la presentacion no usa bibliografia).
#
# Con esto basta con correr, DESDE ESTA CARPETA:
#     latexmk

$pdf_mode = 1;   # 1 = pdflatex -> avance_socioformador.pdf
$out_dir = '.';  # el PDF sale aqui mismo
